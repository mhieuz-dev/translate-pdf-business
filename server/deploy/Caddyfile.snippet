# Dán vào trong khối site mhieuz.com { ... } của Caddyfile, rồi: systemctl reload caddy
# https://mhieuz.com/thongngu-pdf/health -> 127.0.0.1:8787/health
# QUAN TRỌNG: header chung của khối site mhieuz.com phải bỏ qua đường dẫn này, nếu không CSP
# chung của site sẽ đè CSP máy chủ trả về và file PDF mất sandbox:
#   @notthongngu not path /thongngu-pdf/*
#   header @notthongngu { ...các header chung như cũ... }
handle_path /thongngu-pdf/* {
	request_body {
		max_size 32MB
	}
	header {
		-Server
		-X-Powered-By
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Robots-Tag "noindex, nofollow"
	}
	reverse_proxy 127.0.0.1:8787
}
